{
  "name": "pos-kacaw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy:wasm": "node -e \"require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/assets/sql-wasm.wasm')\"",
    "predev": "npm run copy:wasm",
    "prebuild": "npm run copy:wasm",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "bash scripts/open-android.sh"
  },
  "dependencies": {
