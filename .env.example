# Konfigurasi POS Kacaw (frontend). Salin ke `.env` lalu sesuaikan.
# Variabel harus berawalan VITE_ agar terekspos ke kode (import.meta.env).

# Base URL backend POS Pro (Laravel). Default: server lokal artisan serve.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Sign-In (native + web). Isi dengan OAuth Client ID dari Google Cloud
# Console. Untuk web/dev pakai Client ID tipe "Web application"; untuk Android
# server verification pakai Client ID Web yang sama (server_client_id).
# Kosongkan kalau belum pakai login Google.
VITE_GOOGLE_CLIENT_ID=
