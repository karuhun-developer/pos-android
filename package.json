    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.40",
    "@vueuse/core": "^14.4.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "apexcharts": "^6.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jeep-sqlite": "^2.8.0",
